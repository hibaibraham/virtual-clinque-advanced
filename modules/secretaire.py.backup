            st.markdown("---")
            col1, col2, col3 = st.columns(3)
            
            with col1:
                filter_status = st.multiselect(
                    "Filtrer par statut",
                    options=["planifie", "confirme", "annule", "termine"],
                    default=["planifie", "confirme"],
                    format_func=lambda x: {
                        "planifie": "⏳ Planifié",
                        "confirme": "✅ Confirmé",
                        "annule": "❌ Annulé",
                        "termine": "🏁 Terminé"
                    }[x]
                )
            
            with col2:
                filter_period = st.selectbox(
                    "Période",
                    options=["tous", "aujourd'hui", "semaine", "mois"],
                    format_func=lambda x: {
                        "tous": "📅 Tous",
                        "aujourd'hui": "📅 Aujourd'hui",
                        "semaine": "📆 Cette semaine",
                        "mois": "📆 Ce mois"
                    }[x]
                )
            
            with col3:
                sort_by = st.selectbox(
                    "Trier par",
                    options=["date_asc", "date_desc", "patient"],
                    format_func=lambda x: {
                        "date_asc": "📅 Date croissante",
                        "date_desc": "📅 Date décroissante",
                        "patient": "👤 Patient"
                    }[x]
                )
            
            # Filtrer les rendez-vous
            filtered_appointments = [a for a in all_appointments if a.get('status') in filter_status]
            
            # Filtrer par période
            today = datetime.now().date()
            if filter_period == "aujourd'hui":
                filtered_appointments = [a for a in filtered_appointments 
                                       if a.get('date') == today.isoformat()]
            elif filter_period == "semaine":
                week_start = today - timedelta(days=today.weekday())
                week_end = week_start + timedelta(days=6)
                filtered_appointments = [a for a in filtered_appointments 
                                       if week_start.isoformat() <= a.get('date', '') <= week_end.isoformat()]
            elif filter_period == "mois":
                month_start = today.replace(day=1)
                filtered_appointments = [a for a in filtered_appointments 
                                       if a.get('date', '').startswith(month_start.strftime('%Y-%m'))]
            
            # Trier
            if sort_by == "date_asc":
                filtered_appointments.sort(key=lambda x: (x.get('date', ''), x.get('heure', '')))
            elif sort_by == "date_desc":
                filtered_appointments.sort(key=lambda x: (x.get('date', ''), x.get('heure', '')), reverse=True)
            else:
                filtered_appointments.sort(key=lambda x: x.get('patient_nom', ''))
            
            # Afficher le tableau
            st.markdown("---")
            if filtered_appointments:
                appointments_data = []
