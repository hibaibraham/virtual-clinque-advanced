            col1, col2, col3, col4 = st.columns(4)
            
            status_counts = count_appointments_by_status()
            
            with col1:
                st.metric("⏳ Planifiés", status_counts.get('planifie', 0))
            with col2:
                st.metric("✅ Confirmés", status_counts.get('confirme', 0))
            with col3:
                st.metric("❌ Annulés", status_counts.get('annule', 0))
            with col4:
                st.metric("🏁 Terminés", status_counts.get('termine', 0))
            
