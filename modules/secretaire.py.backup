                                    <ol style='color:#94a3b8;margin:0;padding-left:1.2rem;'>
                                        <li>Confirmer le rendez-vous avec le patient</li>
                                        <li>Envoyer un rappel 24h avant</li>
                                        <li>Préparer le dossier médical</li>
                                    </ol>
                                </div>
                                """, unsafe_allow_html=True)
                                
                            except Exception as e:
                                st.error(f"❌ Erreur lors de la création: {str(e)}")
                        else:
                            st.error("❌ Ce créneau n'est plus disponible. Veuillez en choisir un autre.")
    
    # ── Tab 3: Liste des RDV ───────────────────────────────────────────────
    with tab3:
        section_label("📋 Liste de Tous les Rendez-vous")
        
        all_appointments = get_all_appointments()
        
        if not all_appointments:
            st.info("📭 Aucun rendez-vous enregistré pour le moment.")
        else:
            st.success(f"📅 {len(all_appointments)} rendez-vous enregistré(s)")
            
