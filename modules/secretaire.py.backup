                        "ID": apt.get('appointment_id', ''),
                        "Date": apt.get('date', ''),
                        "Heure": apt.get('heure', ''),
                        "Patient": f"{apt.get('patient_nom', '')} {apt.get('patient_prenom', '')}",
                        "Type": apt.get('type_consultation', ''),
                        "Statut": apt.get('status', '').title(),
                        "Durée": f"{apt.get('duree', 30)} min"
                    })
                
                df = pd.DataFrame(appointments_data)
                
                st.dataframe(
                    df,
                    use_container_width=True,
                    hide_index=True
                )
            else:
                st.info("Aucun rendez-vous ne correspond aux filtres sélectionnés.")
    
